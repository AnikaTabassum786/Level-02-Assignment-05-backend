model OrderItem {
  id       String  @id @default(uuid())
  quantity Int
  price    Decimal @db.Decimal(10, 2)

  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade) //Many to one. Many order items are in one order.

  medicineId String
  medicine   Medicine @relation(fields: [medicineId], references: [id], onDelete: Cascade) //Many to one. Many order items are in One medicine

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([orderId, medicineId])
  @@map("orderItems")
}
